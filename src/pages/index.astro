---
import Layout from '../original/layouts/Layout.astro';
import HeroSection from '../original/components/Hero/HeroSection.astro';
import Story from '../original/components/Story/Story.astro';
import Projects from '../original/components/Projects/Projects.astro';
import Summary from '../original/components/Summary/Summary.astro';
import Footer from '../original/components/Footer/Footer.astro';
import MouseTrailer from '../original/components/MouseTrailer/MouseTrailer.astro';
import WhyWorkWithMe from '../original/components/WhyWorkWithMe/WhyWorkWithMe.astro';
import Testimonials from '../original/components/Testimonials/Testimonials.astro';
import Marquee from '../original/components/Marquee/Marquee.astro';
import Preloader from '../original/components/Preloader/Preloader.astro';
---

<Layout>
  <Preloader />
  <MouseTrailer />
  <HeroSection />
  <div class="block md:hidden">
    <Marquee text="The Story I told my wife" />
  </div>
  <Story />
  <Marquee text="Projects? Thought you'd never ask" />
  <Projects />
  <Marquee text="A Developer With Magical Touch" />
  <WhyWorkWithMe />
  <Marquee text="What They Say" />
  <Testimonials />
  <Marquee text="Lorem ipsum dolor? Just Kidding" />
  <Summary />
  <Footer />
</Layout>
