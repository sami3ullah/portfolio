---
import Layout from '../layouts/Layout.astro';
import HeaderSection from '../components/Hero/HeaderSection.astro';
import HeroSection from '../components/Hero/HeroSection.astro';
import Projects from '../components/Projects/Projects.astro';
import Experience from '../components/Summary/Experience.astro';
import Skills from '../components/Summary/Skills.astro';
import AboutMe from '../components/Summary/AboutMe.astro';
import Testimonials from '../components/Testimonials/Testimonials.astro';
import Footer from '../components/Footer/Footer.astro';
---

<Layout>
  <HeaderSection />
  <main id="main" tabindex="-1">
    <HeroSection />
    <Projects />
    <Experience />
    <Skills />
    <Testimonials />
    <AboutMe />
  </main>
  <Footer />
</Layout>
