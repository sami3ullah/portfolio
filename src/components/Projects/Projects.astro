---
import { caseStudies } from '../../data/case-studies';
import profile from '../../data/profile.json';
import ProjectsView from './ProjectsView.astro';
---

<section
  id="portfolio-projects"
  class="section work-section"
  aria-labelledby="work-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Selected work</p>
        <h2 id="work-title">
          Built for real <br />
          <span class="muted">product challenges.</span>
        </h2>
      </div>
      <p>
        Shared foundations, complex workflows, and the frontend decisions behind
        them.
      </p>
    </div>
    <div class="case-studies">
      {caseStudies.map((project) => (
        <ProjectsView project={project} />
      ))}
    </div>
    <article class="assistant-card">
      <div>
        <p class="eyebrow">Personal exploration</p>
        <h3>{profile.assistant.name}</h3>
        <p class="project-status">{profile.assistant.status}</p>
      </div>
      <div>
        <p>
          A small space to explore how software can help with everyday tasks.
        </p>
        <ul>
          {profile.assistant.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </article>
  </div>
</section>
