---
const testimonials = [
  {
    quote:
      'I worked closely with Sami during the early stages of LAAM, and his impact was nothing short of transformative.',
    name: 'Arif Iqbal',
    role: 'Chief Executive Officer at LAAM',
    image: '/testimonials/arif.jpeg',
  },
  {
    quote:
      'Sami is results-oriented, and a true team player who always puts his best effort needed to deliver projects.',
    name: 'Shannon Madden',
    role: 'Senior Project Manager at REI Blackbook',
    image: '/testimonials/shannon.jpeg',
  },
  {
    quote:
      'Sami is a straight forward and honest guy who also has critical thinking skills. Most importantly he is friendly to work with.',
    name: 'Mian Faizan Mahmood',
    role: 'Chief Executive Officer at Emerald Labs',
    image: '/testimonials/faizan.jpeg',
  },
  {
    quote:
      "Sami's excellent communication skills and collaborative nature greatly enriched our team's dynamics.",
    name: 'Rahma Ahmed',
    role: 'Senior Marketing Manager at FOR',
    image: '/testimonials/rahma.jpeg',
  },
];
---

<section class="section container" aria-labelledby="testimonials-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">04 / In their words</p>
      <h2 id="testimonials-title">
        People I’ve <br />
        <span class="muted">worked with.</span>
      </h2>
    </div>
  </div>
  <div class="testimonials-grid">
    {testimonials.map((testimonial) => (
      <figure>
        <blockquote>
          <p>{testimonial.quote}</p>
        </blockquote>
        <figcaption>
          <img
            src={testimonial.image}
            alt=""
            width="48"
            height="48"
            loading="lazy"
          />
          <div>
            <span>{testimonial.name}</span>
            <small>{testimonial.role}</small>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
