---
import { profile } from '../../data/site';
import CopyRights from './CopyRights.astro';
import EmailLink from '../EmailLink.astro';
import BackToTop from '../BackToTop.astro';
---

<footer id="contact" class="section contact-section">
  <div class="container">
    <p class="eyebrow">06 / Get in touch</p>
    <div class="contact-heading">
      <h2>
        Let’s build <br />
        <span class="lime">something useful.</span>
      </h2>
      <svg
        class="contact-arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        aria-hidden="true">
        <path d="M4 20 20 4M4 4h16v16" />
      </svg>
    </div>
    <p class="contact-note">
      Based in {profile.location}. {profile.availabilityMessage}.
    </p>
    <div class="contact-actions">
      <EmailLink class="contact-email" />
    </div>
    <div class="footer-bottom">
      <CopyRights />
      <nav aria-label="Social profiles">
        {Object.entries(profile.links).map(([name, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {name}
          </a>
        ))}
      </nav>
      <BackToTop />
    </div>
  </div>
</footer>
