---
import profile from '../../data/profile.json';
---

<p class="copyright">
  © <span data-current-year>{new Date().getUTCFullYear()}</span> {profile.name}
</p>
<script>
  const updateYear = () =>
    document.querySelectorAll('[data-current-year]').forEach((element) => {
      element.textContent = String(new Date().getUTCFullYear());
    });
  updateYear();
  document.addEventListener('astro:page-load', updateYear);
  window.addEventListener('pageshow', updateYear);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) updateYear();
  });
</script>
