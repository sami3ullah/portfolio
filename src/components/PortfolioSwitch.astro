---
import ActionIcon from './ActionIcon.astro';
import '../styles/glass.css';
interface Props {
  mode?: 'focused' | 'playful';
}
const { mode = 'focused' } = Astro.props;
---

<aside
  data-view={mode}
  class="portfolio-controls"
  aria-label="Choose your portfolio experience">
  <div class="switch-pod">
    <div
      class="switch-surface liquid-glass"
      transition:persist="portfolio-switch"
      aria-hidden="true">
      <div class="switch-track"></div>
    </div>
    <nav aria-label="Portfolio style">
      <a href="/" aria-current={mode === 'playful' ? 'page' : undefined}>
        <ActionIcon name="playful" /> Playful side
      </a>
      <a
        href="/focused/"
        aria-current={mode === 'focused' ? 'page' : undefined}>
        <ActionIcon name="focused" /> To the point
      </a>
    </nav>
  </div>
</aside>

<style>
  .portfolio-controls {
    position: fixed;
    z-index: 90;
    /* Center the 60px switch within the 82px hero row, below its 1px border. */
    bottom: max(10.5px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    line-height: 1.2;
    width: var(--portfolio-switch-width, 344px);
    max-width: calc(100vw - 24px);
  }
  .switch-pod {
    position: relative;
    padding: 6px;
    color: #c4ccbd;
    opacity: var(--intro-controls-opacity, 1);
    transform: translateY(var(--intro-controls-offset, 0px));
    transition:
      opacity var(--intro-controls-duration, 0.6s)
        cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--intro-controls-duration, 0.6s)
        cubic-bezier(0.22, 1, 0.36, 1);
  }
  .switch-surface.liquid-glass {
    position: absolute;
    inset: 0;
    padding: 5px;
    border-radius: 999px;
    background: rgb(18 23 17 / 0.86);
    border-color: rgb(235 255 221 / 0.2);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    backdrop-filter: blur(18px) saturate(130%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 8px 30px rgb(0 0 0 / 0.28);
  }
  nav {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }
  .switch-track {
    position: relative;
    height: 100%;
  }
  .switch-track::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: calc((100% - 4px) / 2);
    border-radius: 999px;
    background: linear-gradient(135deg, #e4ff81, #d5ff3f);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(html[data-portfolio-mode='focused']) .switch-track::before {
    transform: translateX(calc(100% + 4px));
  }
  nav a {
    position: relative;
    padding: 12px 18px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    border-radius: 999px;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }
  nav a:focus-visible {
    outline: 2px solid #edf4df;
    outline-offset: 2px;
  }
  nav a[aria-current='page'] {
    color: #1a240d;
  }
  nav a:hover {
    background-color: #ffffff12;
    color: #fff;
  }
  nav a[aria-current='page']:hover {
    background-color: #ffffff18;
    color: #10170a;
  }
  @media (prefers-reduced-motion: reduce) {
    .switch-pod,
    nav a,
    .switch-track::before {
      transition: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .switch-surface.liquid-glass {
      background: #121711;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (max-width: 700px) {
    .portfolio-controls {
      bottom: max(12px, env(safe-area-inset-bottom));
    }
    nav a {
      padding: 10px 12px;
      min-height: 46px;
      font-size: 0.75rem;
      gap: 8px;
    }
  }
</style>
