---
import { profile, resumeUrl } from '../../data/site';
import EmailLink from '../EmailLink.astro';
import BrandMark from './BrandMark.astro';
import ActionIcon from '../ActionIcon.astro';
import '../../styles/glass.css';
---

<header class="site-header">
  <div class="header-inner container liquid-glass">
    <a href="#top" class="brand" aria-label={`${profile.name}, home`}>
      <BrandMark />
    </a>
    <nav aria-label="Main navigation">
      <a href="#portfolio-projects">Work</a>
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="header-actions">
      <a
        class="button button-primary header-resume"
        href={resumeUrl}
        download
        data-resume>
        <span class="header-resume-label">Resume</span>
        <span class="button-icon" aria-hidden="true">
          <ActionIcon name="resume" />
        </span>
      </a>
      <EmailLink class="header-email" />
    </div>
  </div>
</header>

<script>
  import { onPageReady } from '../../utils/page-lifecycle';
  onPageReady('focused', ({ signal }) => {
    const root = document.documentElement;
    const header = document.querySelector<HTMLElement>('.site-header')!;
    const bar = header.querySelector<HTMLElement>('.header-inner')!;
    const hero = document.querySelector<HTMLElement>('.hero')!;
    const update = () => {
      const compact = scrollY > 24;
      if (compact !== header.hasAttribute('data-scrolled')) {
        header.toggleAttribute('data-scrolled', compact);
        root.style.setProperty(
          '--anchor-header-height',
          compact ? 'var(--compact-header-height)' : 'var(--header-height)'
        );
      }
      header.toggleAttribute(
        'data-past-hero',
        hero.getBoundingClientRect().bottom <=
          bar.getBoundingClientRect().bottom
      );
    };
    window.addEventListener('scroll', update, { passive: true, signal });
    window.addEventListener('resize', update, { signal });
    const resize = new ResizeObserver(update);
    resize.observe(bar);
    resize.observe(hero);
    update();
    return () => {
      resize.disconnect();
      root.style.removeProperty('--anchor-header-height');
    };
  });
</script>
