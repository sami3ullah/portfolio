---
interface Props {
  mode?: 'focused' | 'playful';
}
const { mode = 'focused' } = Astro.props;
const eyeMask = `${mode}-logo-eye`;
---

<svg
  class:list={[
    'brand-mark',
    { 'playful-mark header-logo interactable': mode === 'playful' },
  ]}
  id={mode === 'playful' ? 'logo' : undefined}
  data-logo={mode}
  viewBox="0 0 47 47"
  fill="none"
  aria-hidden="true">
  <defs>
    <mask
      id={eyeMask}
      maskUnits="userSpaceOnUse"
      x="0"
      y="0"
      width="47"
      height="47">
      <rect width="47" height="47" fill="white" />
      <circle data-logo-eye cx="29.4578" cy="13.9014" r="1.9859" fill="black" />
    </mask>
  </defs>
  <path
    mask={`url(#${eyeMask})`}
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M23.5 0C27.5768 0 31.4111 1.03812 34.7531 2.86444L2.27301 13.4043C6.04958 5.47794 14.1351 0 23.5 0ZM1.24118 15.9439C0.436434 18.3152 0 20.8566 0 23.5C0 31.937 4.44613 39.3355 11.1232 43.4804L11.3336 43.4121L17.3907 22.3714L1.24118 15.9439ZM17.958 24.0158L12.4814 43.0396L23.4195 39.4902L17.958 24.0158ZM18.6092 22.8563L23.8339 37.6596L25.4859 27.4719L26.3907 27.0461L28.5302 31.5924L29.6706 27.2588L18.6092 22.8563ZM28.1339 33.0986L28.1338 33.0986L26.2394 29.0729L24.6129 39.1029L34.0337 36.0458L34.0248 35.9389L30.401 28.4125L29.1009 33.3531L28.1339 33.0986ZM33.4296 28.7958L33.7925 33.1513L31.26 27.8913L33.5147 28.7887L33.4296 28.7958ZM43.7922 32.8792L35.0108 35.7288L34.4639 29.1665L43.7922 32.8792ZM23.5 47C19.9434 47 16.5713 46.2099 13.5497 44.7956L44.0568 34.896C40.0464 42.1149 32.3437 47 23.5 47ZM45.6198 31.454C46.5132 28.9699 47 26.2918 47 23.5C47 15.5352 43.0376 8.49578 36.9764 4.24563L4.0793 14.9209L45.6198 31.454ZM25.3099 13.3458C25.8268 12.6136 27.6006 11.0571 30.1986 11.283L30.3718 9.29052C26.8796 8.98685 24.4831 11.0491 23.676 12.1925L25.3099 13.3458Z"
    fill="#95997E"
  />
</svg>
<style>
  .brand-mark {
    width: 44px;
    height: 44px;
    flex: none;
    overflow: visible;
  }
  [data-logo-eye] {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (max-width: 700px) {
    .brand-mark {
      width: 32px;
      height: 32px;
    }
  }
  .brand-mark.playful-mark {
    width: 60px;
    height: 60px;
    margin-top: 70px;
    align-self: flex-start;
  }
  @media (min-width: 768px) {
    .brand-mark.playful-mark {
      width: 82px;
      height: 82px;
    }
  }
</style>
<script>
  import gsap from 'gsap';
  import { onPageReady } from '../../utils/page-lifecycle';
  for (const mode of ['focused', 'playful'] as const) {
    onPageReady(mode, ({ signal, initial }) => {
      const logo = document.querySelector<SVGElement>('[data-logo]')!;
      const eye = logo.querySelector<SVGElement>('[data-logo-eye]')!;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let animations: Animation[] = [];
      let entrance: gsap.core.Tween | undefined;
      let awayFromTop = scrollY > 160;
      let timer: number | undefined;
      let entered = motion.matches;
      const canWink = () => {
        const bounds = logo.getBoundingClientRect();
        return (
          !motion.matches &&
          !signal.aborted &&
          !document.hidden &&
          bounds.bottom > 0 &&
          bounds.top < innerHeight
        );
      };
      const scheduleWink = () => {
        clearTimeout(timer);
        if (!entered || !canWink()) return;
        timer = window.setTimeout(wink, 2000 + Math.random() * 2000);
      };
      const cancel = () => {
        entrance?.revert();
        entrance = undefined;
        clearTimeout(timer);
        animations.forEach((animation) => animation.cancel());
        animations = [];
      };
      const wink = () => {
        if (!canWink()) return;
        animations = animations.filter(
          (animation) => animation.playState === 'running'
        );
        const animation = eye.animate(
          [
            { transform: 'scaleY(1)', offset: 0 },
            { transform: 'scaleY(.12)', offset: 0.35 },
            { transform: 'scaleY(.12)', offset: 0.52 },
            { transform: 'scaleY(1)', offset: 1 },
          ],
          { id: 'logo-wink', duration: 320, easing: 'ease-in-out' }
        );
        animations.push(animation);
        scheduleWink();
      };
      const enter = () => {
        if (motion.matches || signal.aborted) return;
        entrance = gsap.fromTo(
          logo,
          { scale: 2.5, rotation: -360, opacity: 0 },
          {
            scale: 1,
            rotation: 0,
            opacity: 1,
            duration: 1.3,
            delay: mode === 'playful' && initial ? 6.5 : 0,
            ease: 'power4.inOut',
            onComplete: () => {
              gsap.set(logo, { clearProps: 'transform,opacity' });
              entered = true;
              wink();
            },
          }
        );
      };
      if (
        mode === 'focused' &&
        document.querySelector('.view-curtain[data-active]')
      ) {
        document.addEventListener('portfolio:revealed', enter, {
          once: true,
          signal,
        });
      } else enter();
      window.addEventListener(
        'scroll',
        () => {
          if (scrollY > Math.max(160, innerHeight * 0.25)) awayFromTop = true;
          if (awayFromTop && scrollY <= 8) {
            awayFromTop = false;
            wink();
          }
        },
        { passive: true, signal }
      );
      motion.addEventListener(
        'change',
        () => {
          if (motion.matches) cancel();
          else {
            entered = true;
            scheduleWink();
          }
        },
        { signal }
      );
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) cancel();
          else {
            entered = true;
            scheduleWink();
          }
        },
        { signal }
      );
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) scheduleWink();
        else clearTimeout(timer);
      });
      observer.observe(logo);
      return () => {
        observer.disconnect();
        cancel();
      };
    });
  }
</script>
