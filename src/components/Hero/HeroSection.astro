---
import { Image } from 'astro:assets';
import Portrait from '../../../public/hero-image.webp';
import ExperienceText from '../ExperienceText.astro';
import ActionIcon from '../ActionIcon.astro';
import { profile, resumeUrl } from '../../data/site';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="hero-eyebrow">
      <span class="eyebrow">{profile.location}</span>
      <span class="hero-experience">
        <ExperienceText />
      </span>
    </div>
    <h1 id="hero-title">
      <span>Senior </span>
      <span class="lime">Frontend </span>
      <span>Engineer</span>
    </h1>
    <p class="hero-description">
      I develop web applications and shared UI systems with React and
      TypeScript, with a focus on accessibility, maintainability, and complex
      business workflows.
    </p>
    <div class="actions">
      <a class="button button-primary" href={resumeUrl} download data-resume>
        <span>Resume</span>
        <span class="button-icon" aria-hidden="true">
          <ActionIcon name="resume" />
        </span>
      </a>
      <a class="button" href="#contact">
        <span>Contact</span>
        <span class="button-icon" aria-hidden="true">
          <ActionIcon name="contact" />
        </span>
      </a>
    </div>
  </div>
  <div class="hero-portrait">
    <Image
      src={Portrait}
      alt="Muhammad Samiullah"
      widths={[480, 720, 960]}
      sizes="(max-width: 700px) 0px, 45vw"
      width={720}
      height={680}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="portrait-caption">
      <span class="portrait-description">
        Reusable components. <br />
        Reliable, accessible applications.
      </span>
    </div>
  </div>
  <div class="hero-bottom">
    <a class="availability-link" href="#contact">
      {profile.availabilityMessage}
    </a>
    <span>
      React <span aria-hidden="true">/</span> TypeScript{' '}
      <span aria-hidden="true">/</span> UI architecture
    </span>
  </div>
</section>
