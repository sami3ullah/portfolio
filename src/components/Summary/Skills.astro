---
import profile from '../../data/profile.json';
---

<section
  id="skills"
  class="section skills-section"
  aria-labelledby="skills-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Toolkit</p>
        <h2 id="skills-title">
          Frontend first. <br />
          <span class="muted">Solid foundations.</span>
        </h2>
      </div>
      <p>
        My focus is frontend architecture, design systems, and complex
        interfaces. Backend experience supports that work.
      </p>
    </div>
    <div class="skills-grid">
      {profile.skills.map((skill) => (
        <article>
          <h3>{skill.name}</h3>
          <ul class="tags">
            {skill.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
