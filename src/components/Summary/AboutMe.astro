---
import profile from '../../data/profile.json';
interface Props {
  showStory?: boolean;
}
const { showStory = true } = Astro.props;
---

<section
  id="about"
  class="section container about-section"
  aria-labelledby="about-title">
  <div>
    <p class="eyebrow">05 / A little about me</p>
    <h2 id="about-title">
      A builder. <br />
      <span class="muted">Always learning.</span>
    </h2>
  </div>
  <div class="about-copy">
    <p>
      I’m {profile.name}, a {profile.title.toLowerCase()} based in{' '}
      {profile.location}. Since June 2019, I’ve worked on e-commerce tools,
      design systems, and enterprise applications.
    </p>
    <p>
      I enjoy making complicated workflows easier to use and giving teams
      reliable components to build with. Alongside frontend work, I use Claude
      and Codex in development and explore voice interaction through my local
      personal assistant.
    </p>
    {showStory && (
      <details id="main__story">
        <summary>The story behind the work</summary>
        <p>
          I grew up in a small town with limited access to technology and wanted
          to become a software engineer. Moving to a larger city for college was
          a big adjustment. Learning to code helped me find my direction.
        </p>
        <p>
          That experience still shapes how I work: ask questions, learn
          deliberately, and keep building.
        </p>
        <a class="text-link" href="#portfolio-projects">
          Skip Story <span aria-hidden="true">↑</span>
        </a>
      </details>
    )}
  </div>
</section>
