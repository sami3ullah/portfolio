---
import profile from '../../data/profile.json';
import { monthYear } from '../../utils/dates.mjs';
import ExperienceText from '../ExperienceText.astro';
---

<section
  id="experience"
  class="section container"
  aria-labelledby="experience-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">02 / Experience</p>
      <h2 id="experience-title">
        The work <br />
        <span class="muted">behind the craft.</span>
      </h2>
    </div>
    <p>
      <ExperienceText />
    </p>
  </div>
  <ol class="timeline">
    {profile.roles.map((role) => (
      <li>
        <div class="role-dates">
          <time datetime={role.start}>{monthYear(role.start)}</time> -{' '}
          <time datetime={role.end}>{monthYear(role.end)}</time>
          <span>{role.location}</span>
        </div>
        <div class="role-details">
          <h3>{role.company}</h3>
          <p class="role-title">{role.title}</p>
          <ul>
            {role.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
