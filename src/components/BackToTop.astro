---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a class:list={['back-to-top', className]} href="#top" aria-label="Back to top">
  <span class="back-to-top-copy">
    <span class="back-to-top-kicker" aria-hidden="true">
      One more look?
    </span>
    <span class="back-to-top-label">Back to top</span>
  </span>
  <span class="back-to-top-icon" aria-hidden="true">
    <span class="back-to-top-arrows">
      {[false, true].map((repeat) => (
        <svg
          class:list={{ 'return-arrow': repeat }}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M12 20V4m-7 7 7-7 7 7" />
        </svg>
      ))}
    </span>
  </span>
</a>

<style>
  .back-to-top {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 20px;
    padding: 0;
    color: #edf1e6;
    text-decoration: none;
  }
  .back-to-top-copy {
    display: grid;
    gap: 5px;
    text-align: left;
  }
  .back-to-top-kicker {
    color: #a8ae9d;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .back-to-top-label {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }
  .back-to-top-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid #78845b;
    border-radius: 50%;
    background: #d5ff3f08;
    color: #d5ff3f;
    transition:
      color 240ms ease,
      background-color 240ms ease,
      border-color 240ms ease;
  }
  .back-to-top-arrows {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 32px;
    overflow: hidden;
  }
  svg {
    position: absolute;
    width: 26px;
    height: 26px;
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .return-arrow {
    transform: translateY(125%);
  }
  .back-to-top:is(:hover, :focus-visible) .back-to-top-icon {
    color: #14190e;
    background: #d5ff3f;
    border-color: #d5ff3f;
  }
  .back-to-top:is(:hover, :focus-visible) svg {
    transform: translateY(-125%);
  }
  .back-to-top:is(:hover, :focus-visible) .return-arrow {
    transform: translateY(0);
  }
  .back-to-top:focus-visible {
    outline: 2px solid #d5ff3f;
    outline-offset: 8px;
    border-radius: 4px;
  }
  @media (max-width: 700px) {
    .back-to-top {
      gap: 16px;
    }
    .back-to-top-icon {
      width: 56px;
      height: 56px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top-icon,
    svg {
      transition: none;
    }
    .back-to-top:is(:hover, :focus-visible) svg {
      transform: none;
    }
    .return-arrow {
      display: none;
    }
  }
</style>
