---
import Flower from './Flower.astro';
---

<div class="brands-wrapper bg-black text-white relative z-10">
  <div
    class="work-track gap-4 md:gap-8"
    id="why-work-with-me"
    role="region"
    aria-label="Why work with me, scroll to explore"
    tabindex="0"
    data-lenis-prevent>
    <div class="bg-primary brands-section pin px-10 min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] rounded-3xl relative overflow-hidden">
      <div class="text-[3rem] md:text-[4rem] text-background -rotate-90 font-[500] z-[1] absolute top-1/2 left-[85%] lg:left-3/4 -translate-x-3/4 -translate-y-1/2 w-full">
        Why Work <br /> With Me?
      </div>
      <div class="absolute top-0 -left-[62%] md:-left-[50%] lg:-left-[42%] xl:-left-[35%] 2xl:-left-[36%] trasnlate-x-1/2 opacity-40">
        <Flower />
      </div>
    </div>
    <div class="bg-darkBackground brands-section pin min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] p-10 rounded-3xl">
      <span class="anim text-textDullest text-[1.8rem] md:text-[3rem] lg:text-[4rem]">
        01
      </span>
      <h2 class="text-textLightPrimary font-bold text-left text-[1.8rem] md:text-[2rem] z-[1] lg:text-[2.4rem] mb-[20px] tracking-[3px] md:tracking-[5px] uppercase">
        Diverse <br /> Experience
      </h2>

      <div class="col z-1 relative">
        <p class="text-textDullest w-full max-w-[calc(100vw-40px)] font-[300] text-[1.2rem] leading-[30px] md:text-[1.4rem] text-left md:leading-[40px]">
          I've cultivated a versatile skillset through my experiences with
          startups, software houses, and service-based companies, ensuring I am
          well-equipped to tackle any challenge.
        </p>
      </div>
    </div>
    <div class="bg-darkBackground brands-section pin min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] p-10 rounded-3xl">
      <span class="anim text-textDullest text-[1.8rem] md:text-[3rem] lg:text-[4rem]">
        02
      </span>
      <h2 class="text-textLightPrimary anim text-left font-bold text-[1.8rem] md:text-[2rem] z-[1] lg:text-[2.4rem] mb-[20px] tracking-[3px] md:tracking-[5px] uppercase">
        Framework <br /> Independent
      </h2>

      <div class="col anim z-1 relative">
        <p class="text-textDullest w-full max-w-[calc(100vw-40px)] font-[300] text-[1.2rem] leading-[30px] md:text-[1.4rem] text-left md:leading-[40px]">
          As an Engineer, my expertise extends beyond specific languages or
          frameworks. Instead, I'm adept at selecting the most suitable
          technology as per project requirement.
        </p>
      </div>
    </div>
    <div class="bg-darkBackground brands-section pin min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] p-10 rounded-3xl">
      <span class="anim text-textDullest text-[1.8rem] md:text-[3rem] lg:text-[4rem]">
        03
      </span>
      <h2 class="text-textLightPrimary anim text-left font-bold text-[1.8rem] md:text-[2rem] z-[1] lg:text-[2.4rem] mb-[20px] tracking-[3px] md:tracking-[5px] uppercase">
        AI <br /> Ready
      </h2>

      <div class="col anim z-1 relative">
        <p class="text-textDullest w-full max-w-[calc(100vw-40px)] font-[300] text-[1.2rem] leading-[30px] md:text-[1.4rem] text-left md:leading-[40px]">
          I use AI tools to explore ideas, build features, and improve everyday
          workflows. From a personal voice assistant to production interfaces, I
          pair experimentation with careful review, testing, and maintainable
          code.
        </p>
      </div>
    </div>
    <div class="bg-darkBackground brands-section pin min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] p-10 rounded-3xl">
      <span class="anim text-textDullest text-[1.8rem] md:text-[3rem] lg:text-[4rem]">
        04
      </span>
      <h2 class="text-textLightPrimary anim text-left font-bold text-[1.8rem] md:text-[2rem] z-[1] lg:text-[2.4rem] mb-[20px] tracking-[3px] md:tracking-[5px] uppercase">
        Result <br /> Driven
      </h2>

      <div class="col anim z-1 relative">
        <p class="text-textDullest w-full max-w-[calc(100vw-40px)] font-[300] text-[1.2rem] leading-[30px] md:text-[1.4rem] text-left md:leading-[40px]">
          Delivering exceptional results is my unwavering goal. I'm committed to
          going above and beyond expectations to ensure your success. Your
          satisfaction is my driving force.
        </p>
      </div>
    </div>
    <div class="bg-darkBackground brands-section pin min-w-[33%] md:min-w-[50%] lg:min-w-[44%] xl:min-w-[36%] 2xl:min-w-[30%] max-h-[100%] p-10 rounded-3xl">
      <span class="anim text-textDullest text-[1.8rem] md:text-[3rem] lg:text-[4rem]">
        05
      </span>
      <h2 class="text-textLightPrimary anim text-left font-bold text-[1.8rem] md:text-[2rem] z-[1] lg:text-[2.4rem] mb-[20px] tracking-[3px] md:tracking-[5px] uppercase">
        Team <br /> Player
      </h2>

      <div class="col anim z-1 relative">
        <p class="text-textDullest w-full max-w-[calc(100vw-40px)] font-[300] text-[1.2rem] leading-[30px] md:text-[1.4rem] text-left md:leading-[40px]">
          I thrive in collaborative environments and value the input of others.
          Your input is highly valued, and together, we can transform your
          projects into resounding achievements.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .brands-wrapper {
    padding-inline: 20px;
    overflow: clip;
  }
  .work-track {
    position: relative;
    display: flex;
    width: 100%;
    overflow-x: auto;
    padding-block: 48px;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y pinch-zoom;
  }
  .work-track:focus-visible {
    outline: 2px solid #d5ff3f;
    outline-offset: -2px;
  }
  .brands-section {
    flex: 0 0 min(82vw, 460px);
    min-width: 0;
    scroll-snap-align: start;
    scroll-margin: 0;
    padding: clamp(24px, 3vw, 40px);
  }
  .brands-section h2 {
    font-size: clamp(1.5rem, 2.3vw, 2.4rem);
    line-height: 1.4;
    min-height: 2.8em;
    letter-spacing: 0.08em;
    margin-top: 12px;
  }
  .brands-section p {
    font-size: clamp(1rem, 1.4vw, 1.4rem);
    line-height: 1.7;
  }
  .brands-section > span {
    font-size: clamp(2rem, 4vw, 4rem);
  }
  @media (min-width: 768px) {
    .brands-wrapper {
      padding-inline: 70px;
    }
    .work-track {
      padding-block: 80px;
    }
  }
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .brands-wrapper[data-scroll-driven] .work-track {
      position: sticky;
      top: 0;
      overflow: visible;
      padding-block: clamp(48px, 12vh, 120px);
    }
    .brands-section {
      flex-basis: clamp(360px, 32vw, 500px);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { playfulEffect } from '../../utils/page-effects';
  playfulEffect(() => {
    const track = document.querySelector<HTMLElement>('#why-work-with-me')!;
    const media = gsap.matchMedia();
    // Touch devices keep native horizontal scrolling, including large tablets.
    // Desktop keeps the original scroll-driven presentation.
    media.add(
      '(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
      () => {
        const wrapper = track.parentElement!;
        wrapper.setAttribute('data-scroll-driven', '');
        track.removeAttribute('data-lenis-prevent');
        track.scrollLeft = 0;
        const sections = [
          ...track.querySelectorAll<HTMLElement>('.brands-section'),
        ];
        const distance = () => {
          const last = sections[sections.length - 1];
          return Math.max(
            0,
            last.offsetLeft + last.offsetWidth - track.clientWidth
          );
        };
        const reserveScrollSpace = () => {
          gsap.set(wrapper, { height: track.offsetHeight + distance() });
        };
        reserveScrollSpace();
        gsap.to(sections, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: wrapper,
            scrub: true,
            start: 'top top',
            end: () => `+=${distance()}`,
            invalidateOnRefresh: true,
            onRefreshInit: reserveScrollSpace,
          },
        });
        return () => {
          wrapper.removeAttribute('data-scroll-driven');
          track.setAttribute('data-lenis-prevent', '');
        };
      }
    );
    return () => media.revert();
  });
</script>
