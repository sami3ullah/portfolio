---
import { wholeYearsSince } from '../../../utils/dates.mjs';
import { profile } from '../../../data/site';
---

<section class="about-me-section py-[70px] md:py-[80px] lg:py-[100px] flex flex-col lg:flex-row justify-between border-b border-darkBorder">
  <div>
    <h2 class="text-[30px] md:text-[50px] lg:text-[4rem] leading-[70px] lg:leading-[80px] font-bold mb-[30px] text-textLightPrimary">
      About Me
    </h2>
    <div class="max-w-none lg:max-w-[310px] text-textDullest text-[1rem] leading-[1.5em] mb-[40px]">
      I’m a Pakistani software engineer currently based in Munich, Germany. I
      love what I do and have done, so for the last{' '}
      <span data-experience-years data-experience-start={profile.careerStart}>
        {wholeYearsSince(profile.careerStart)}
      </span>
      + years I’ve worked on various projects, brands and companies around the
      world. As an engineer, I bring my passion for creative problem-solving,
      design, and effective teamwork to every project. I'm always excited to
      collaborate and bring fresh ideas to the table!
    </div>
  </div>
  <div class="ml-0 lg:ml-[80px] max-w-none md:max-w-[80%] lg:max-w-[61%] w-full">
    <h3 class="text-[22px] md:text-[24px] leading-[30px] md:leading-[34px] mb-[30px] text-textLightPrimary">
      I've developed and worked for:
    </h3>
    <div class="text-[30px] md:text-[50px] lg:text-[4rem] leading-[40px] md:leading-[60px] lg:leading-[80px] text-textLightPrimary">
      Innoscripta <br />
      Tkxel <br />
      Laam <br />
      Ali Xeeshan <br />
      Emerald Labs <br />
      Mohsin Naveed Ranjha <br />
      Shamsha Hashwani <br />
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playfulEffect } from '../../utils/page-effects';
  playfulEffect(() => {
    gsap.registerPlugin(ScrollTrigger);

    gsap.to('.fixed_footer', {
      scrollTrigger: {
        trigger: '.about-me-section',
        start: 'top top%',
        end: 'bottom 80%',
        scrub: true,
      },
      zIndex: 2,
    });
  });
</script>
