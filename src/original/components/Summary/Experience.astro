---
import { wholeYearsSince } from '../../../utils/dates.mjs';
import { profile } from '../../../data/site';
---

<section class="py-[70px] md:py-[80px] lg:py-[100px] flex flex-col lg:flex-row justify-between border-b border-darkBorder">
  <div>
    <h2 class="text-[30px] md:text-[50px] lg:text-[4rem] leading-[70px] lg:leading-[80px] font-bold mb-[30px] text-textLightPrimary">
      Experience
    </h2>
    <div class="max-w-none lg:max-w-[310px] text-textDullest text-[1rem] leading-[1.5em] mb-[40px]">
      Web App Development <br />
      Industry Practices <br />
      System Design <br />
      Design Patterns <br />
      Versatile Development <br />
      Teamwork <br />
      Team Leading <br />
      Strong communication <br />
      Visual Design <br />
    </div>
  </div>
  <div class="career-summary ml-0 lg:ml-[80px] max-w-none lg:max-w-[61%] w-full">
    <h3 class="text-[22px] md:text-[24px] leading-[30px] md:leading-[34px] mb-[30px] text-textLightPrimary">
      Quick summary of my career:
    </h3>
    <div class="career-total">
      <div class="career-years">
        <span data-experience-years data-experience-start={profile.careerStart}>
          {wholeYearsSince(profile.careerStart)}
        </span>
        +
      </div>
      <p>
        years of development experience
        <span>Building for the web since 2019</span>
      </p>
    </div>
    <ol class="career-timeline">
      {profile.roles.map((role) => (
        <li>
          <div>
            <h4>{role.company.replace(/ AG$/, '')}</h4>
            <p>{role.title}</p>
          </div>
          <span class="career-dates">
            <time datetime={role.start}>{role.start.slice(0, 4)}</time> -{' '}
            <time datetime={role.end}>{role.end.slice(0, 4)}</time>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .career-summary {
    min-width: 0;
  }
  .career-total {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
    color: #b9bcad;
  }
  .career-years {
    color: #d5ff3f;
    font-size: clamp(4rem, 6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }
  .career-total p {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.5;
  }
  .career-total p span {
    display: block;
    margin-top: 6px;
    font-size: 0.875rem;
    color: #a2a290;
  }
  .career-timeline li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid #252621;
  }
  .career-timeline h4 {
    color: #b9bcad;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .career-timeline p {
    color: #a2a290;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-top: 4px;
  }
  .career-dates {
    flex: none;
    color: #a2a290;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 380px) {
    .career-total {
      gap: 16px;
    }
    .career-timeline li {
      flex-wrap: wrap;
      gap: 10px;
    }
  }
</style>
