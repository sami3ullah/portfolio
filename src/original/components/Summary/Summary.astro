---
import AboutMe from './AboutMe.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Achievements from './Achievements.astro';
---

<!-- Reserve a full viewport for the footer reveal and its bottom controls. -->
<section class="summary z-30 relative bg-black px-pageXMobile md:px-pageX">
  <AboutMe />
  <Experience />
  <Skills />
  <Achievements />
</section>

<style>
  .summary {
    margin-bottom: 100svh;
  }
  @media (max-height: 799px) {
    .summary {
      margin-bottom: 0;
    }
  }
</style>
