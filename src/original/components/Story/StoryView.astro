---
interface Props {
  id?: string;
  index: number;
}

const { id, index } = Astro.props;
---

<div
  id={id}
  style={`--story-index: ${index}`}
  class="story_view min-h-[45vh] border-b border-darkBorder md:border-none w-full">
  <div class="story-surface flex items-center">
    <div>
      <div class="text-textDullest text-left text-[12px] md:text-[1rem] font-[700] mb-[20px] mt-[20px] md:mt-[0px] tracking-[3px] md:tracking-[5px] uppercase">
        Story
      </div>
      <slot />
    </div>
  </div>
</div>

<style>
  .story_view {
    position: relative;
    background: #101110;
  }
  .story-surface {
    min-height: inherit;
    padding-block: 40px;
  }
  .story_view :global(.story_text) {
    width: 100%;
    color: #b9bcad;
    font-size: 1.5rem;
    line-height: 40px;
    text-align: left;
  }
  @media (min-width: 768px) {
    .story_view {
      border: 1px solid #252820;
      border-radius: 20px;
    }
    .story-surface {
      padding: clamp(32px, 4.5vw, 64px);
    }
    .story_view :global(.story_text) {
      font-size: clamp(1.5rem, 3.8vw, 3.5rem);
      line-height: 1.35;
    }
  }
  @media (min-width: 768px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .story_view {
      /* Native sticky cards follow scroll without a second smoothing clock.
         Each card keeps its width while scrolling so the text never reflows. */
      position: sticky;
      top: calc(32px + var(--story-index) * 12px);
      width: calc(92% + var(--story-index) * 2%);
      margin-inline: auto;
      min-height: calc(100svh - 180px);
    }
  }
</style>
