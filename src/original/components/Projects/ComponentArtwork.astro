</style>

<script>
  import { onPageReady } from '../../../utils/page-lifecycle';

  onPageReady('playful', ({ signal }) => {
    const artwork = document.querySelector<HTMLElement>(
      '[data-component-artwork]'
    );
    if (!artwork) return;
    let visible = false;
    const update = () => {
      artwork.toggleAttribute('data-playing', visible && !document.hidden);
    };
    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        update();
      },
      { threshold: 0.15 }
    );
    observer.observe(artwork);
    document.addEventListener('visibilitychange', update, { signal });
    return () => {
      observer.disconnect();
      artwork.removeAttribute('data-playing');
    };
  });
</script>
