---
import { resumeUrl } from '../../../data/site';
import Character from './Character.astro';
import CopyRights from './CopyRights.astro';
---

<section class="fixed_footer bg-darkBackground md:flex md:items-center md:gap-[5vw] px-pageXMobile md:px-pageX pb-[60px] md:pb-[90px] w-full">
  <div>
    <h2 class="text-textLightPrimary text-center md:text-left mb-[50px] text-[30px] md:text-[50px] lg:text-[4rem] leading-[1.133em] lg:leading-[1.33em] font-bold">
      Bug Me!
    </h2>
    <!-- open email on click -->

    <a
      href="mailto:msami398@gmail.com"
      class="interactable interactable-link text-textLightPrimary text-center md:text-left block uppercase mb-[40px]">
      msami398@gmail.com
    </a>
    <div class="interactable interactable-link text-center md:text-left mb-[20px] md:mb-[80px]">
      <a
        href="https://www.linkedin.com/in/samidev/"
        aria-label="Checkout my Linkedin profile"
        target="_blank"
        class="mr-[20px] relative text-[16px] leading-[24px] text-textDullest hover:text-darkBackground2 py-[15px]">
        LinkedIn
      </a>
      <a
        href="https://github.com/sami3ullah"
        aria-label="Checkout my Github profile"
        target="_blank"
        class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
        Github
      </a>
      <a
        href="https://stackoverflow.com/users/6900808/sami"
        aria-label="Checkout my Stackoverflow profile"
        target="_blank"
        class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
        Stackoverflow
      </a>
      <a
        href={resumeUrl}
        data-resume
        download
        aria-label="Get my Resume"
        rel="noopener noreferrer"
        target="_blank"
        class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
        Resume
      </a>
    </div>
    <!-- Moving Text -->
    <div class="flex justify-center md:block">
      <CopyRights text="©Muhammad. All Rights Reserved" />
    </div>
  </div>
  <div class="flex-1 opacity-[0.35] hidden md:block">
    <Character />
  </div>
  <div class="footer-return">
    <a class="back-to-top interactable" href="#top">
      Back to top
      <span aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M6 4h12M12 20V9m-5 5 5-5 5 5" />
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .fixed_footer {
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: -100;
    min-height: 100svh;
    padding-top: 110px;
  }
  .footer-return {
    position: absolute;
    right: 20px;
    bottom: calc(124px + env(safe-area-inset-bottom, 0px));
  }
  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 6px 6px 6px 16px;
    border: 1px solid #666d5c;
    border-radius: 999px;
    color: #b9bcad;
    font-size: 13px;
    font-weight: 600;
  }
  .back-to-top span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #d5ff3f;
    color: #101110;
  }
  .back-to-top svg {
    width: 20px;
    height: 20px;
    transition: transform 180ms ease;
  }
  .back-to-top:hover {
    border-color: #d5ff3f;
  }
  .back-to-top:hover svg {
    transform: translateY(-2px);
  }
  .back-to-top:focus-visible {
    outline: 2px solid #d5ff3f;
    outline-offset: 4px;
  }
  @media (min-width: 768px) {
    .footer-return {
      right: 70px;
    }
  }
  @media (max-width: 767px) {
    .fixed_footer {
      padding-top: 64px;
      padding-bottom: calc(194px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-height: 799px) {
    .fixed_footer {
      position: relative;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top svg,
    .back-to-top:hover svg {
      transition: none;
      transform: none;
    }
  }
</style>
