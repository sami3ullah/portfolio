---
import { resumeUrl } from '../../../data/site';
import Character from './Character.astro';
import CopyRights from './CopyRights.astro';
import BackToTop from '../../../components/BackToTop.astro';
---

<section class="fixed_footer bg-darkBackground px-pageXMobile md:px-pageX w-full">
  <div class="footer-content">
    <div>
      <h2 class="text-textLightPrimary text-center md:text-left mb-[50px] text-[30px] md:text-[50px] lg:text-[4rem] leading-[1.133em] lg:leading-[1.33em] font-bold">
        Bug Me!
      </h2>
      <!-- open email on click -->

      <a
        href="mailto:msami398@gmail.com"
        class="interactable interactable-link text-textLightPrimary text-center md:text-left block uppercase mb-[40px]">
        msami398@gmail.com
      </a>
      <div class="interactable interactable-link text-center md:text-left mb-[20px] md:mb-[80px]">
        <a
          href="https://www.linkedin.com/in/samidev/"
          aria-label="Checkout my Linkedin profile"
          target="_blank"
          class="mr-[20px] relative text-[16px] leading-[24px] text-textDullest hover:text-darkBackground2 py-[15px]">
          LinkedIn
        </a>
        <a
          href="https://github.com/sami3ullah"
          aria-label="Checkout my Github profile"
          target="_blank"
          class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
          Github
        </a>
        <a
          href="https://stackoverflow.com/users/6900808/sami"
          aria-label="Checkout my Stackoverflow profile"
          target="_blank"
          class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
          Stackoverflow
        </a>
        <a
          href={resumeUrl}
          data-resume
          download
          aria-label="Get my Resume"
          rel="noopener noreferrer"
          target="_blank"
          class="mr-[20px] relative text-[16px] leading-[24px] transition-all text-textDullest hover:text-darkBackground2 py-[15px]">
          Resume
        </a>
      </div>
      <!-- Moving Text -->
      <div class="flex justify-center md:block">
        <CopyRights text="©Muhammad. All Rights Reserved" />
      </div>
    </div>
    <div class="footer-artwork flex-1 opacity-[0.35] hidden md:block">
      <Character />
    </div>
  </div>
  <div class="footer-return">
    <p class="footer-signoff">Thanks for stopping by.</p>
    <BackToTop class="interactable" />
  </div>
</section>

<style>
  .fixed_footer {
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: -100;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: clamp(48px, 6svh, 80px);
    padding-bottom: calc(112px + env(safe-area-inset-bottom, 0px));
  }
  .footer-content {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 5vw;
    width: 100%;
  }
  .footer-artwork {
    min-width: 0;
  }
  .footer-artwork :global(svg) {
    width: min(100%, 440px);
    height: auto;
  }
  .footer-return {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid #3b4034;
  }
  .footer-signoff {
    color: #a8ae9d;
    font-size: 12px;
    line-height: 1.5;
  }
  @media (max-width: 767px) {
    .fixed_footer {
      padding-top: 64px;
    }
    .footer-content {
      display: block;
    }
    .footer-return {
      justify-content: center;
    }
    .footer-signoff {
      display: none;
    }
  }
  @media (max-height: 799px) {
    .fixed_footer {
      position: relative;
    }
  }
</style>
